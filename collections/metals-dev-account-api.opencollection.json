{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metals.Dev Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.metals.dev/v1/usage"
          },
          "docs": "Returns current usage, plan details, and remaining quota."
        }
      ]
    }
  ],
  "bundled": true
}